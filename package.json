{
  "name": "klotracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Klopatra – die Toiletten-Tracking-App mit Augenzwinkern",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "app:sync": "vite build && cap sync",
