    "@capacitor/share": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^13.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
